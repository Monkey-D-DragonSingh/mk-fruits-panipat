# MK Fruits Panipat API environment
# Copy to server/.env and fill real values

PORT=3001
CORS_ORIGIN=*

# Supabase (required for persistent bookings)
# Get from Supabase project: Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Owner panel
OWNER_PASSWORD=MKFP-OWNER-2026

# Cron (optional)
CRON_SECRET=change-me
