# MK Fruits Panipat API environment
# Copy to server/.env and fill real values

PORT=3001
# Set to your frontend origin(s) in production, e.g. https://your-site.vercel.app
CORS_ORIGIN=*

# Supabase (required for persistent cloud database in production)
# Get from Supabase project: Settings -> API. Run supabase/schema.sql in SQL Editor.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Owner panel authentication
# Use OWNER_PASSWORD for simple setup, or OWNER_PASSWORD_HASH (scrypt$saltHex$hashHex) for stronger security.
OWNER_PASSWORD=MKFP-OWNER-2026
# AUTH_SECRET=change-this-to-a-long-random-secret
# SESSION_TTL_HOURS=12

# Notifications (configure any/all; cron processes outbox: GET /api/cron?secret=CRON_SECRET)
OWNER_NOTIFY_PHONE=8221900072
OWNER_NOTIFY_EMAIL=mkfreshfruitpanipat@gmail.com
CRON_SECRET=change-me

# Optional: forward notifications to your automation/webhook (WhatsApp/SMS/email provider)
# NOTIFY_WEBHOOK_URL=https://your-webhook.example.com
# NOTIFY_WEBHOOK_SECRET=optional-secret

# Optional: SMTP email (owner/customer confirmations)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=app-password
# SMTP_FROM="MK Fruits Panipat <no-reply@example.com>"
